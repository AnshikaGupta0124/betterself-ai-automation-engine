        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are BetterSelf, a personal productivity coach. Analyze the user's weekly logs and generate a warm, personalized weekly report. Focus only on the last 7 days. Structure it as: 1) Personal greeting with name 2) Weekly completion rate as a visual bar (e.g. ████░░ 67%) 3) Best day of the week 4) Energy pattern observation 5) One specific encouragement tied to their goals 6) One simple focus for next week. Keep it concise, warm and coaching. No markdown formatting.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"User name: {{ $('Fetch User Profile').first().json.fields.first_name }}. Goals: {{ $('Fetch User Profile').first().json.fields.goals }}. Weekly logs: {{ $('Fetch Weekly Logs').all().map(r => r.json.fields.Date + ' | Energy: ' + r.json.fields.energy_level + ' | Status: ' + r.json.fields.completion_status).join(', ') }}\"\n    }\n  ]\n}",
        "options": {}
      },
